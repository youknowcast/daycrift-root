---
import { getCollection } from "astro:content";
import Layout from "@/layouts/Layout.astro";
import Header from "@/components/Header.astro";
import Breadcrumb from "@/components/Breadcrumb.astro";
import Main from "@/components/Main.astro";
import Footer from "@/components/Footer.astro";
import Card from "@/components/Card.astro";
import { postFilter } from "@/utils/postFilter";
import { getPostsByGroupCondition } from "./_utils/getPostsByGroupCondition";
import { useTranslations } from "@/i18n";
import config from "@/config";

// 無効時はルート自体を生成しない (ソフト 404 の防止)。
// 有効時は /archives/ の 1 ページだけを生成する。
export async function getStaticPaths() {
  if (!config.features.showArchives) {
    return [];
  }
  // Astro 7 はルートパラメータに string / undefined しか受理しない
  return [{ params: { slug: undefined } }];
}

const locale = Astro.currentLocale ?? config.site.lang;

const t = useTranslations(locale);

// 年月のグループ化はビルドホストのタイムゾーンに依存しないよう、
// サイト設定のタイムゾーンで正規化して行う
const timeZone = config.site.timezone;
const ymFormatter = new Intl.DateTimeFormat("en-CA", {
  timeZone,
  year: "numeric",
  month: "2-digit",
});

const posts = await getCollection("posts");
const filteredPosts = posts.filter(postFilter);
const monthFormatter = new Intl.DateTimeFormat(locale, { month: "long" });
---

<Layout title={`${t.pages.archivesTitle} | ${config.site.title}`}>
  <Header />

  <Breadcrumb />

  <Main pageTitle={t.pages.archivesTitle} pageDesc={t.pages.archivesDesc}>
    {
      Object.entries(
        getPostsByGroupCondition(filteredPosts, post =>
          Number(ymFormatter.format(post.data.pubDatetime).slice(0, 4))
        )
      )
        .sort(([yearA], [yearB]) => Number(yearB) - Number(yearA))
        .map(([year, yearGroup]) => (
          <div>
            <span class="text-2xl font-bold">{year}</span>
            <sup class="text-muted-foreground text-sm">{yearGroup.length}</sup>
            {Object.entries(
              getPostsByGroupCondition(yearGroup, post =>
                Number(ymFormatter.format(post.data.pubDatetime).slice(5, 7))
              )
            )
              .sort(([monthA], [monthB]) => Number(monthB) - Number(monthA))
              .map(([month, monthGroup]) => (
                <div class="flex flex-col sm:flex-row">
                  <div class="mt-6 min-w-36 text-lg sm:my-6">
                    <span class="font-bold">
                      {monthFormatter.format(
                        new Date(2000, Number(month) - 1, 1)
                      )}
                    </span>
                    <sup class="text-muted-foreground text-xs">
                      {monthGroup.length}
                    </sup>
                  </div>
                  <ul>
                    {monthGroup
                      .sort(
                        (a, b) =>
                          Math.floor(
                            new Date(b.data.pubDatetime).getTime() / 1000
                          ) -
                          Math.floor(
                            new Date(a.data.pubDatetime).getTime() / 1000
                          )
                      )
                      .map(data => (
                        <Card {...data} />
                      ))}
                  </ul>
                </div>
              ))}
          </div>
        ))
    }
  </Main>

  <Footer />
</Layout>
